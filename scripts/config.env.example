# fedora-setup -- Configuration locale
# Copier en scripts/config.env et adapter

# KVM
KVM_IMAGES_DIR="/var/lib/libvirt/images"
KVM_NETWORK="default"
KVM_SUBNET="192.168.122"

# Backup Borg
BORG_REPO="/mnt/backup_cold/borg"
BORG_FAST_DIR="/backups/fast"

# Backup Timeshift
TIMESHIFT_DIR="/backups/fast"

# Vaultwarden
BW_SERVER="http://127.0.0.1:8222"
BW_SESSION_FILE="/root/.bw-session"

# Logs MCP
MCP_LOG_DIR="/var/log/mcp-agents"

# SSH
VM_SSH_USER="votre-utilisateur"
VM_SSH_KEY="${HOME}/.ssh/id_ed25519"
